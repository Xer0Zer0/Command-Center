<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3KIG Command Center</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: #0d1117; color: #c9d1d9; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        
        header { background: #161b22; padding: 14px 16px; font-size: 1rem; font-weight: 600; border-bottom: 1px solid #30363d; display: flex; justify-content: space-between; align-items: center; }
        .status-pill { font-size: 0.75rem; background: #21262d; border: 1px solid #30363d; padding: 4px 8px; border-radius: 12px; color: #3fb950; display: flex; align-items: center; gap: 6px; }
        .status-pill::before { content: ""; width: 6px; height: 6px; background: #3fb950; border-radius: 50%; }

        .quick-actions { display: flex; gap: 8px; padding: 8px 12px; background: #161b22; border-bottom: 1px solid #30363d; overflow-x: auto; white-space: nowrap; }
        .quick-actions::-webkit-scrollbar { display: none; }
        .chip { background: #21262d; border: 1px solid #30363d; color: #8b949e; padding: 6px 12px; border-radius: 16px; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
        .chip:active { background: #30363d; color: #c9d1d9; }

        .chat-container { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
        .message { background: #21262d; border: 1px solid #30363d; padding: 12px 14px; border-radius: 8px; max-width: 90%; word-break: break-word; font-size: 0.95rem; line-height: 1.4; }
        .message.user { background: #1f6feb; border-color: #388bfd; color: #ffffff; align-self: flex-end; }
        
        .input-container { padding: 12px; background: #161b22; border-top: 1px solid #30363d; display: flex; gap: 8px; }
        input { flex: 1; background: #0d1117; border: 1px solid #30363d; border-radius: 6px; padding: 10px 14px; color: #c9d1d9; font-size: 1rem; outline: none; }
        input:focus { border-color: #58a6ff; }
        button { background: #238636; color: white; border: none; border-radius: 6px; padding: 0 18px; font-weight: 600; font-size: 0.95rem; cursor: pointer; }
        button:active { background: #2ea043; }
    </style>
</head>
<body>
    <header>
        <span>3KIG Command Center</span>
        <div class="status-pill">Online</div>
    </header>

    <div class="quick-actions">
        <div class="chip" onclick="sendPreset('/status')">/status</div>
        <div class="chip" onclick="sendPreset('/sync')">/sync</div>
        <div class="chip" onclick="sendPreset('List modules')">List modules</div>
        <div class="chip" onclick="sendPreset('Clear screen')">Clear screen</div>
    </div>

    <div class="chat-container" id="chatContainer">
        <div class="message">Mobile client UI optimized. Supabase bridge ready.</div>
    </div>

    <div class="input-container">
        <input type="text" id="userInput" placeholder="Type a command..." onkeydown="handleKey(event)">
        <button onclick="sendMessage()">Send</button>
    </div>

    <script>
        const SUPABASE_URL = 'YOUR_SUPABASE_PROJECT_URL';
        const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';
        
        const supabaseClient = (SUPABASE_URL && SUPABASE_ANON_KEY !== 'YOUR_SUPABASE_ANON_KEY') 
            ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) 
            : null;

        function handleKey(e) {
            if (e.key === 'Enter') sendMessage();
        }

        function sendPreset(text) {
            document.getElementById('userInput').value = text;
            sendMessage();
        }

        async function sendMessage() {
            const input = document.getElementById('userInput');
            const container = document.getElementById('chatContainer');
            const text = input.value.trim();
            if (!text) return;
            
            if (text === 'Clear screen') {
                container.innerHTML = '<div class="message">Screen cleared.</div>';
                input.value = '';
                return;
            }

            const userMsg = document.createElement('div');
            userMsg.className = 'message user';
            userMsg.textContent = text;
            container.appendChild(userMsg);
            
            input.value = '';
            container.scrollTop = container.scrollHeight;

            if (supabaseClient && text.startsWith('/')) {
                try {
                    console.log("Supabase active, handling command:", text);
                } catch (err) {
                    console.error("Supabase error:", err);
                }
            }

            setTimeout(() => {
                const aiMsg = document.createElement('div');
                aiMsg.className = 'message';
                aiMsg.textContent = "Executed: " + text;
                container.appendChild(aiMsg);
                container.scrollTop = container.scrollHeight;
            }, 350);
        }
    </script>
</body>
</html>
