<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3KIG Command Center</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: #0d1117; color: #c9d1d9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 20px; }
        header { background: #161b22; padding: 15px; border-radius: 6px; margin-bottom: 20px; font-size: 1.25rem; font-weight: bold; border: 1px solid #30363d; }
        .status-pill { font-size: 0.75rem; background: #238636; padding: 2px 8px; border-radius: 12px; float: right; }
        .chat-container { display: flex; flex-direction: column; gap: 10px; }
    </style>
</head>
<body>
    <header>
        3KIG Command Center
        <span class="status-pill">Active</span>
    </header>
    <div class="chat-container">
        <!-- Interface content elements -->
    </div>
    
    <script>
        // Supabase logging helper example
        async function logCommand(commandText) {
            // Placeholder for client logging
            console.log("Command logged successfully:", commandText);
        }
    </script>
    
    <script>
        const ws = new WebSocket("ws://127.0.0.1:8765");

        ws.onopen = function() {
            console.log("Connected to Aethel Orchestrator");
            ws.send(JSON.stringify({
                agent: "System",
                action: "ping",
                payload: { status: "client_active" }
            }));
        };

        ws.onmessage = function(event) {
            const data = JSON.parse(event.data);
            console.log("State update received:", data);
        };

        ws.onerror = function(error) {
            console.error("WebSocket error:", error);
        };
    </script>
</body>
</html>
