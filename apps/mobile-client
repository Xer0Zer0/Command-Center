<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3KIG Command Center - Mobile Client</title>
    <!-- Supabase CDN for frontend client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: #0d1117; color: #c9d1d9; display: flex; flex-direction: column; height: 100vh; }
        header { background: #161b22; padding: 16px; font-size: 1.1rem; font-weight: bold; border-bottom: 1px solid #30363d; text-align: center; }
        .chat-container { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
        .message { background: #21262d; padding: 12px 16px; border-radius: 8px; max-width: 85%; word-break: break-word; }
        .message.user { background: #1f6feb; color: #ffffff; align-self: flex-end; }
        .input-container { padding: 12px; background: #161b22; border-top: 1px solid #30363d; display: flex; gap: 8px; }
        input { flex: 1; background: #0d1117; border: 1px solid #30363d; border-radius: 6px; padding: 10px 14px; color: #c9d1d9; font-size: 1rem; outline: none; }
        input:focus { border-color: #58a6ff; }
        button { background: #238636; color: white; border: none; border-radius: 6px; padding: 0 16px; font-weight: bold; cursor: pointer; }
        button:active { background: #2ea043; }
    </style>
</head>
<body>
    <header>3KIG Command Center</header>
    <div class="chat-container" id="chatContainer">
        <div class="message">Mobile client active. Secure bridge ready.</div>
    </div>
    <div class="input-container">
        <input type="text" id="userInput" placeholder="Send command...">
        <button onclick="sendData()">Send</button>
    </div>
    <script>
        // Use your public Supabase Anon Key here safely on the client side
        const SUPABASE_URL = 'YOUR_SUPABASE_PROJECT_URL';
        const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';
        
        const supabaseClient = window.supabase ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;

        async function sendData() {
            const input = document.getElementById('userInput');
            const container = document.getElementById('chatContainer');
            if (!input.value.trim()) return;
            
            const text = input.value;
            
            const userMsg = document.createElement('div');
            userMsg.className = 'message user';
            userMsg.textContent = text;
            container.appendChild(userMsg);
            
            input.value = '';
            container.scrollTop = container.scrollHeight;

            // Example integration step with Supabase if needed
            if (supabaseClient) {
                // You can log actions or invoke workers here
            }

            setTimeout(() => {
                const aiMsg = document.createElement('div');
                aiMsg.className = 'message';
                aiMsg.textContent = "Acknowledged: " + text;
                container.appendChild(aiMsg);
                container.scrollTop = container.scrollHeight;
            }, 400);
        }
    </script>
</body>
</html>
