<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3KIG Command Center</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: #0d1117; color: #c9d1d9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 16px; }
        header { background: #161b22; padding: 14px; border-radius: 8px; margin-bottom: 16px; font-size: 1.1rem; font-weight: bold; border: 1px solid #30363d; }
        .status-pill { font-size: 0.75rem; background: #238636; padding: 2px 8px; border-radius: 12px; float: right; color: #fff; }
        .quick-actions { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
        .chip { background: #21262d; border: 1px solid #30363d; padding: 8px 14px; border-radius: 6px; color: #c9d1d9; cursor: pointer; font-size: 0.9rem; }
        .chip:active { background: #30363d; }
        .chat-container { display: flex; flex-direction: column; gap: 12px; }
    </style>
</head>
<body>
    <header>
        3KIG Command Center
        <span class="status-pill">Online</span>
    </header>

    <div class="quick-actions">
        <button class="chip" onclick="logCommand('system:boot')">Boot System</button>
        <button class="chip" onclick="logCommand('sync:database')">Sync DB</button>
        <button class="chip" onclick="logCommand('diag:run')">Run Diagnostics</button>
    </div>

    <script>
        const SUPABASE_URL = 'YOUR_SUPABASE_URL';
        const SUPABASE_ANON_KEY = 'sb_publishable_your_actual_key_here';
        
        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        async function logCommand(commandText) {
            const { data, error } = await supabase
                .from('command_logs')
                .insert([{ command: commandText, status: 'pending' }]);
                
            if (error) {
                console.error('Error logging command:', error);
            } else {
                console.log('Command logged successfully:', data);
            }
        }
    </script>
</body>
</html>
